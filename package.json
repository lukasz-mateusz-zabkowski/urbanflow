{
  "name": "urbanflow",
  "version": "1.2.1-alpha",
  "private": true,
  "type": "module",
  "description": "Lekka przeglądarkowa strategia transportowa oparta o prawdziwą geografię miast.",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "test": "node --test",
    "test:browser": "playwright test",
    "routing:build": "node scripts/build-routing-graph.mjs",
    "audit:all": "npm audit --audit-level=moderate",
    "audit:production": "npm audit --omit=dev --audit-level=moderate"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^5.1.0",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1"
  }
}
